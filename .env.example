# =============================================================================
# .env.example — шаблон настроек стека vpn-docker.
#
#   cp .env.example .env && chmod 600 .env      # затем отредактируйте значения
#
# install.sh делает это автоматически. Секреты (HIDDEN_PATH, SECRET_BASE64,
# SECRET_PASSWORD, TROJAN_PASSWORD) можно оставить пустыми — их сгенерирует
# scripts/generate-secrets.sh (идемпотентно: существующие значения не трогает).
#
# ВНИМАНИЕ: после любой правки этого файла/`.env` выполните ./manage.sh reload
# Файл .env находится в .gitignore — никогда не коммитьте его со секретами!
# =============================================================================

# --- Обязательные настройки ---------------------------------------------------
# Публичный домен, A-запись которого указывает на этот сервер.
DOMAIN=vpn.example.com
# Email для Let's Encrypt (уведомления о истечении сертификата).
ACME_EMAIL=admin@example.com

# --- Режим выпуска сертификата ------------------------------------------------
# true — тестовый (staging) CA Let's Encrypt: без лимитов, но браузеры/клиенты
# могут не доверять сертификату. Используйте для проверки конфигурации.
USE_STAGING=false

# --- Профиль Xray ---------------------------------------------------------------
# main   = VLESS + WebSocket + TLS (рекомендуется)
# trojan = Trojan + WebSocket + TLS (использует TROJAN_PASSWORD ниже)
PROFILE=main

# --- Публикуемые порты nginx ----------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443

# --- Секреты (можно оставить пустыми — заполнит generate-secrets.sh) -----------
# Скрытый WS-путь вида /api/v1/<hex>/stream. Пока он не задан, конфиги не
# будут отрендерены.
HIDDEN_PATH=
# Anti-replay defenses Xray (secretId / password).
SECRET_BASE64=
SECRET_PASSWORD=
# Пароль для PROFILE=trojan (генерируется только при PROFILE=trojan).
TROJAN_PASSWORD=

# --- Внутренняя сеть / порты -----------------------------------------------------
# Порт Xray внутри docker-сети (наружу НЕ публикуется).
XRAY_INTERNAL_PORT=10000
# Имя docker-сети стека.
NETWORK_NAME=vpn-frontend

# --- Образы (закреплены; менять через ./update.sh --to <image> <VAR>) ----------
# ВНИМАНИЕ: ghcr.io/xtls/xray-core публикует только теги вида 1.8.x / latest /
# main — тегов формата YY.M.DD (например 25.9.8) там НЕТ, docker pull такой образ
# не найдёт ("not found"). Актуальные теги: https://github.com/XTLS/Xray-core/releases
NGINX_IMAGE=nginx:1.27-alpine
XRAY_IMAGE=ghcr.io/xtls/xray-core:1.8.23
CERTBOT_IMAGE=certbot/certbot:v3.1.0

# --- Прочее -----------------------------------------------------------------------
# Каталог для резервных копий backup.sh (относительно корня проекта или абсолютный).
BACKUP_DIR=./backups
# Уровень логов Xray: error | warning | info | debug
LOG_LEVEL=warning
